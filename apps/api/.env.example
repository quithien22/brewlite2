DATABASE_URL="postgresql://brewlite:brewlite@localhost:5433/brewlite?schema=public"
JWT_SECRET="doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien"
JWT_EXPIRES_IN="7d"
# Client ID của OAuth (Google Cloud Console → APIs & Services → Credentials), dùng cho "Đăng nhập với Google".
# Phải trùng với NEXT_PUBLIC_GOOGLE_CLIENT_ID ở apps/web. Để trống thì nút Google trả lỗi "chưa được cấu hình".
GOOGLE_CLIENT_ID=""
PORT=4000
# Có thể khai báo nhiều origin, ngăn cách bằng dấu phẩy
FRONTEND_URL="http://localhost:3000"
# Đơn PENDING / PAYMENT_FAILED quá số phút này sẽ tự hủy và hoàn kho, mã, điểm (FR-27)
ORDER_EXPIRE_MINUTES=15
# Khách chỉ tự hủy + được hoàn tiền đơn đã thanh toán trong số phút này kể từ lúc thanh toán
REFUND_WINDOW_MINUTES=5
# RabbitMQ: gửi/nhận sự kiện đơn hàng (order.created / paid / cancelled / refunded).
# Để trống hoặc xóa dòng này thì tắt RabbitMQ, API vẫn chạy bình thường.
# Chạy API thủ công trên máy: để trống. Chạy bằng docker compose: compose tự đặt biến này
# (amqp://...@rabbitmq:5672), không cần khai báo ở đây.
RABBITMQ_URL=""

# Gửi email (mã đặt lại mật khẩu). Để trống SMTP_HOST thì KHÔNG gửi thật, chỉ in nội dung email (kèm mã) ra log của API.
# Dùng Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng" (App Password) rồi điền vào SMTP_PASS (không dùng mật khẩu Gmail thường).
# SMTP_HOST: ví dụ smtp.gmail.com | SMTP_PORT: 587 (STARTTLS) hoặc 465 (TLS) | SMTP_SECURE: true nếu dùng cổng 465
# SMTP_USER: ví dụ ten.ban@gmail.com | SMTP_PASS: App Password 16 ký tự
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BrewLite <ten.ban@gmail.com>"
