# Biến môi trường cho docker-compose.yml
# Sao chép thành .env để ghi đè; không có .env thì docker-compose dùng giá trị mặc định này.
# (Chạy thủ công không qua Docker thì dùng apps/api/.env.example và apps/web/.env.example)

# --- PostgreSQL ---
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite

# --- RabbitMQ (broker gửi/nhận sự kiện đơn hàng) ---
# Trên EC2 hãy đổi mật khẩu; chỉ dùng chữ và số để khỏi phải URL-encode
RABBITMQ_USER=brewlite
RABBITMQ_PASSWORD=brewlite

# --- Backend (apps/api) ---
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-va-ngau-nhien
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
# Google OAuth Client ID: dùng chung cho backend (xác thực token) và frontend (hiện nút Google)
GOOGLE_CLIENT_ID=891745779425-nrpduohofosnbl4paltfb6fjdkeljhcm.apps.googleusercontent.com

# Gửi email mã đặt lại mật khẩu. Để trống SMTP_HOST thì không gửi thật, chỉ in email (kèm mã) ra log của container backend.
# Gmail: dùng App Password (bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng"), SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BrewLite <ten.ban@gmail.com>"

# --- Frontend (apps/web) ---
# Trình duyệt gọi trực tiếp backend nên dùng địa chỉ localhost
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Demo thanh toán thất bại (đặt false khi triển khai thật) ---
MOCK_PAYMENT_ALLOW_FAILURE=true
NEXT_PUBLIC_ALLOW_MOCK_FAILURE=true
